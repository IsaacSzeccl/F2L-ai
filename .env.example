# Copy this file to ".env" in the project root, then fill in your own keys.
# ".env" is ignored by git. Never commit it, and never paste keys into chat.
# After editing, quit and relaunch Beacon.

ZAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional fallback brain:
ANTHROPIC_API_KEY=

# Bug reports (the "Bug" button and the bug-reports/ folder). On by default.
# Uncomment to turn the whole feature off: the button disappears and nothing is captured or saved.
# Takes effect the next time the bar opens; no restart needed.
# BEACON_BUG_REPORTS=off
