<Window x:Class="F2L.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F2L Settings" Width="452" Height="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FEFEFF" Foreground="#242529" FontFamily="{StaticResource UiFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="F2L settings" FontSize="23" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,19,0,16">
            <TextBlock Text="AI coach" FontWeight="SemiBold" />
            <TextBlock x:Name="ProviderText" Text="DeepSeek · deepseek-flash" Margin="0,4,0,0" Foreground="#706581" />
            <TextBlock Text="Switch with AI provider in Pip's menu, or set &quot;Provider&quot; in the file below (deepseek, openai, gemini, claude, glm)." TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Foreground="#737780" />
            <TextBlock Text="F2L reads the active app window when you send a question, unless screen sharing is paused from Pip's menu." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#737780" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Your local configuration" FontWeight="SemiBold" />
            <TextBlock x:Name="SettingsPath" Margin="0,4,0,0" Foreground="#706581" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock Text="Keys stay in this private file on this computer. Git ignores it, and scripts/check-secrets.sh stops a commit that contains a key." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#737780" />
        </StackPanel>
        <Border Grid.Row="3" Background="#F3F1F8" CornerRadius="12" Padding="12" VerticalAlignment="Top">
            <TextBlock Text="The latest 500 messages and your draft are saved on this device. Screenshots aren't saved. Simple cell-pointing requests are checked locally with desktop Excel; other questions and their shared screen image go to the AI provider you chose." TextWrapping="Wrap" FontSize="11" Foreground="#737780" />
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Show file" Click="ShowFile_Click" Padding="16,7" Margin="0,0,8,0" />
            <Button Content="Done" Click="Done_Click" Padding="16,7" />
        </StackPanel>
    </Grid>
</Window>
